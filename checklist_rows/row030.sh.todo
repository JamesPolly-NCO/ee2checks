#!/bin/bash
# Is execution trace turned on with ‘set -x’ in shell scripts?
if (($# != 1)); then
    echo "usage: $0 /path/to/package"
    echo "e.g. $0 /lfs/h1/ops/para/packages/rrfs.v1.0.0"
    exit
fi

if [ -d $1 ]; then
    echo "Checking: $1"
else
    echo "$1 does not exist" && exit
fi

rownum="022"

logfile=out${rownum}.log
[[ -e "${logfile}" ]] && rm -rf ${logfile}

echo "Not implemented. Lots of manual stuff to do here."
